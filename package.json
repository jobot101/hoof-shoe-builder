{
  "name": "shoe-builder",
  "version": "1.0.0",
  "private": true,
  "description": "Ragamuffin Studios Shoe Builder - trace a hoof, export a fitted 3D-printable shoe (React)",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-opencv.js && vite build && node scripts/make-sw.js",
    "build:artifact": "vite build --mode artifact && node scripts/artifact-page.js",
    "sync": "npm run build && npx cap sync"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/camera": "8.2.4",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.2",
    "@capacitor/share": "8.0.2",
    "@techstark/opencv-js": "^4.12.0-release.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@fontsource/barlow-condensed": "5.2.6",
    "@fontsource/ibm-plex-mono": "5.2.6",
    "@fontsource/source-sans-3": "5.2.8",
    "@vitejs/plugin-react": "^6.1.2",
    "clipper-lib": "6.4.2",
    "earcut": "2.2.4",
    "three": "0.128.0",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "type": "commonjs"
}
